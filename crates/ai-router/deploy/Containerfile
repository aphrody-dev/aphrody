# The router service as a container for any container platform (serverless containers, Kubernetes, a single host).
# The binary is static (musl) and carries its TLS roots, so the image holds nothing else.
FROM scratch
COPY ai-router /ai-router
EXPOSE 8080
# serving beyond loopback needs AI_ROUTER_TOKENS (callers send one as a bearer token)
ENTRYPOINT ["/ai-router", "serve", "--addr", "0.0.0.0:8080"]

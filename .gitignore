.dev.vars
*.pem
*.key
*.p12
*.pfx
!tooling/**/*.pem
!tooling/**/*.key
!crates/**/fixtures/**

# Next / Turbo / JS coverage
.next/
.turbo/
coverage/

# OS & Editor (github/gitignore Global)
Thumbs.db
[Dd]esktop.ini
*.swp
*~
.vs/

# Generated by agents and telemetry (kernel-watch pages, probe and lane records, boot logs): never tracked.
/.private/
# Externalized aphrody-labs/* forks are resolved via pinned GitHub Release tags (tooling/bun/forks-manifest.json).
/vendor/

# WSL2 guest side. dxgkrnl (/dev/dxg, GPU-PV) exists only in the Microsoft tree: CONFIG_DXGKRNL is set there by Microsoft/config-wsl and is
# unknown to mainline and linux-next, where this fragment leaves it out on purpose.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_HYPERV=y
# linux-next splits the VMBus core out of CONFIG_HYPERV; the Microsoft 6.18 tree has no such symbol (the line is dropped there)
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_VSOCKETS=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_BALLOON=y
CONFIG_VSOCKETS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_9P_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

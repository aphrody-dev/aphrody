# Performance settings that are Kconfig. Instruction-set tuning is a compiler flag, not a symbol (KCFLAGS=-march=x86-64-v3 or the target CPU);
# X86_NATIVE_CPU would tune for the build machine, so it stays off.
# CONFIG_X86_NATIVE_CPU is not set
CONFIG_HZ_1000=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF_JIT=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_IOSCHED_BFQ=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_KSM=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

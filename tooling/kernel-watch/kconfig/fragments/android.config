# Android userspace (Waydroid, redroid-style containers, Cuttlefish guests).
# The Rust binder replaces the C one; there is no ashmem (memfd) and no binderfs symbol in linux-next, only these:
CONFIG_ANDROID_BINDER_IPC_RUST=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_MEMFD_CREATE=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_HYPERV_VSOCKETS=y
# Namespaces, cgroups and pressure information used by Android's init, lmkd and container runtimes
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_PSI=y
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# dma-buf heaps and sync files (gralloc, sync fences)
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y
CONFIG_UDMABUF=y
# Image formats and filesystems of Android system images
CONFIG_EROFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_F2FS_FS=m
# Networking of container based Android (bridge, veth, nat)
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_MACVLAN=y
CONFIG_NF_TABLES=y
CONFIG_NFT_MASQ=m
CONFIG_NFT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y

# Rust mode. The mainline binder is Rust only (drivers/android has no C binder), so Android needs CONFIG_RUST.
# Minimum toolchain per Documentation/process/changes.rst of the tree; check with: make LLVM=1 rustavailable
CONFIG_RUST=y
CONFIG_BLK_DEV_RUST_NULL=m
CONFIG_DRM_PANIC_SCREEN_QR_CODE=y
CONFIG_NOVA_CORE=m
CONFIG_DRM_NOVA=m

{
  "name": "aphrody-tooling",
  "private": true,
  "description": "Typed Bun CLI automation, WebGPU/Wasm build & verification, skill generation, and fleet orchestration for the Aphrody monorepo.",
  "scripts": {
    "xtask": "bun tooling/bun/cli.ts",
    "studio:list": "bun tooling/bun/cli.ts list",
    "studio:check": "bun tooling/bun/cli.ts check",
    "studio:status": "cargo xtask studio status",
    "studio:parity": "cargo xtask studio parity",
    "submodules:status": "bun tooling/bun/submodules.ts status",
    "submodules:check": "bun tooling/bun/submodules.ts check",
    "submodules:sync": "bun tooling/bun/submodules.ts sync --jobs 8",
    "vendor:doctor": "bun tooling/bun/vendor-lan-doctor.ts audit",
    "web:matrix": "bun tooling/bun/web-build.ts matrix",
    "web:audit": "bun tooling/bun/web-build.ts audit",
    "web:check": "bun tooling/bun/web-build.ts check",
    "web:build": "bun tooling/bun/web-build.ts build --package aphrody_desktop --opt",
    "web:build:release": "bun tooling/bun/web-build.ts build --package aphrody_desktop --release --opt",
    "web:verify": "bun tooling/bun/web-verify.ts --package aphrody_desktop",
    "web:serve": "bun tooling/bun/web-build.ts serve --port 4195",
    "skill:crate": "bun tooling/bun/crate-to-skill.ts",
    "fleet:sync": "bun tooling/bun/fleet-sync.ts sync --host fr1",
    "fleet:sync:all": "bun tooling/bun/fleet-sync.ts sync --all",
    "fleet:verify": "bun tooling/bun/fleet-sync.ts verify --host fr1 --pull-shots",
    "fleet:parallel": "bun tooling/bun/fleet-sync.ts parallel-build --all",
    "fleet:deploy": "bun tooling/bun/fleet-sync.ts deploy --host fr1 --edge-host prd",
    "fleet:lb": "bun tooling/bun/fleet-lb.ts",
    "learn:sync": "bun tooling/bun/learn-cloud.ts",
    "host:audit": "bun tooling/bun/ci-host-optimize.ts audit --host fr1",
    "host:audit:all": "bun tooling/bun/ci-host-optimize.ts audit --all",
    "host:apply": "bun tooling/bun/ci-host-optimize.ts apply --host fr1 --offload-cold",
    "host:apply:all": "bun tooling/bun/ci-host-optimize.ts apply --all --offload-cold",
    "host:bench": "bun tooling/bun/ci-host-optimize.ts bench --host fr1",
    "worktree:list": "bun tooling/bun/worktree.ts list",
    "worktree:create": "bun tooling/bun/worktree.ts create",
    "worktree:prune": "bun tooling/bun/worktree.ts prune",
    "cross:doctor": "bun tooling/bun/cross-build.ts doctor",
    "cross:matrix": "bun tooling/bun/cross-build.ts matrix",
    "cross:check": "bun tooling/bun/cross-build.ts check",
    "store:sync": "bun tooling/bun/awesome-gpui-store.ts sync",
    "store:sync-all": "bun tooling/bun/awesome-gpui-store.ts sync-all",
    "store:package": "bun tooling/bun/awesome-gpui-store.ts package",
    "store:verify": "bun tooling/bun/awesome-gpui-store.ts verify --dir target/gpui-store-dist",
    "ingest:longbridge": "bun tooling/bun/longbridge-ingest.ts scan",
    "ingest:graph": "bun tooling/bun/longbridge-ingest.ts graph",
    "ingest:centralize": "bun tooling/bun/longbridge-ingest.ts centralize",
    "ingest:wasm-bindgen": "bun tooling/bun/wasm-bindgen-ingest.ts all",
    "ingest:emscripten": "bun tooling/bun/emscripten-crawl.ts all",
    "cf:audit": "bun tooling/bun/cloudflare-deploy.ts audit --dry-run",
    "cf:deploy": "bun tooling/bun/cloudflare-deploy.ts deploy",
    "cf:dev": "wrangler dev --config .cloudflare/aphrody-worker/wrangler.toml",
    "r2:manifest": "bun tooling/bun/r2-assets.ts manifest",
    "r2:push": "bun tooling/bun/r2-assets.ts push",
    "r2:hydrate": "bun tooling/bun/r2-assets.ts hydrate",
    "r2:prune": "bun tooling/bun/r2-assets.ts prune-local",
    "disk:slim": "bun tooling/bun/disk-slim.ts apply",
    "sync:status": "bun tooling/bun/upstream-sync.ts status",
    "sync:all": "bun tooling/bun/upstream-sync.ts sync --target all",
    "sync:resolve": "bun tooling/bun/upstream-sync.ts resolve",
    "fmt:check": "cargo fmt --all -- --check",
    "clippy": "cargo xtask clippy",
    "clippy:fast": "cargo clippy -j 4 --no-deps -- -D warnings",
    "test:nextest": "cargo nextest run",
    "toolchain:doctor": "bun tooling/bun/toolchain-audit.ts doctor",
    "toolchain:profile-diff": "bun tooling/bun/toolchain-audit.ts profile-diff",
    "toolchain:fork-plan": "bun tooling/bun/toolchain-audit.ts fork-plan",
    "audit:gpui-vs-dioxus": "bun tooling/bun/gpui-vs-dioxus-audit.ts all",
    "audit:agent-desktop": "bun tooling/bun/agent-desktop-audit.ts",
    "agy:audit": "bun tooling/bun/agy-config-audit.ts",
    "brand:check": "cargo xtask brand check",
    "design:sync": "bun tooling/bun/google-design-sync.ts sync",
    "design:audit": "bun tooling/bun/google-design-sync.ts audit",
    "design:pack": "bun tooling/bun/design-docs-pack.ts build",
    "design:capture": "bun tooling/bun/design-docs-pack.ts capture",
    "storytold:sync": "bun tooling/bun/storytold-unify.ts sync",
    "storytold:audit": "bun tooling/bun/storytold-unify.ts audit",
    "agy:studio": "bun tooling/bun/agy-session-studio.ts",
    "standards:matrix": "bun tooling/bun/prod-standards-starterpack.ts matrix",
    "standards:bench": "bun tooling/bun/prod-standards-starterpack.ts bench",
    "standards:audit": "bun tooling/bun/prod-standards-starterpack.ts all",
    "conformity": "cargo xtask package-conformity",
    "i18n:check": "bun tooling/bun/w3c-i18n.ts check",
    "i18n:audit": "bun tooling/bun/w3c-i18n.ts audit",
    "i18n:fix": "bun tooling/bun/w3c-i18n.ts fix",
    "licenses": "cargo xtask licenses",
    "hygiene": "bun tooling/bun/repo-hygiene.ts",
    "shell:doctor": "bun tooling/bun/shell-path-doctor.ts audit",
    "shell:optimize": "bun tooling/bun/shell-path-doctor.ts optimize",
    "ingest:webassembly": "bun tooling/bun/webassembly-org-ingest.ts all",
    "issues:wasm-wgpu": "bun tooling/bun/zed-wasm-wgpu-issues.ts audit",
    "test:tooling": "bun test --timeout 20000 tooling/bun"
  }
}

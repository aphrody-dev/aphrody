{
  "gpui-os-session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bun ./hooks/session-start.ts",
        "timeout": 10
      }
    ]
  },
  "gpui-os-command-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bun ./hooks/pre-tool-guard.ts",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "gpui-os-file-conformity": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "bun ./hooks/post-edit-check.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

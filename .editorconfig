# W3C Internationalization & cross-platform encoding baseline
# https://www.w3.org/International/questions/qa-choosing-encodings
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.rs]
indent_size = 4

[*.{ts,tsx,js,mjs,cjs,json,toml,yml,yaml,html,css,svg,sh,ps1}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
charset = utf-8
end_of_line = crlf

[Makefile]
indent_style = tab
